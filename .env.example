# Copy to .env for local experiments. Never commit the real file.
#
# Leave everything unset to use the Claude Agent SDK through the local
# Claude Code CLI — no key required. That is the default on a dev machine.

# Force a backend instead of auto-detecting:
#   claude_agent | openai_compat | auto   (default: auto)
# EXTRACTION_PROVIDER=openai_compat

# OpenAI-compatible endpoint (OpenRouter by default)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=nex-agi/nex-n2.5-pro:free
# OPENAI_COMPAT_VISION_MODEL=nex-agi/nex-n2.5-pro:free
