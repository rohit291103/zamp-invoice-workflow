# Copy to .env for local experiments. Never commit the real file.
#
# Leave everything unset to use the Claude Agent SDK through the local
# Claude Code CLI — no key required. That is the default on a dev machine.

# Force a backend instead of auto-detecting:
#   claude_agent | openai_compat | auto   (default: auto)
# EXTRACTION_PROVIDER=openai_compat

# --- text path (machine-readable PDFs) -------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_MODEL=nvidia/nemotron-3.5-lightning:free

# --- vision path (scanned pages) -------------------------------------
# Configured separately because many strong free text models — Nemotron
# among them — accept no image input at all, so the scanned-invoice path
# has to route to a different model, sometimes a different provider.
# OPENAI_COMPAT_VISION_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_VISION_MODEL=nex-agi/nex-n2.5-pro:free
# OPENAI_COMPAT_VISION_API_KEY=            # only if vision uses another provider

# --- using NVIDIA's hosted API directly for the text path -------------
# Nemotron is text-only, so vision must still point somewhere else.
# NVIDIA_API_KEY=nvapi-...
# OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_COMPAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
